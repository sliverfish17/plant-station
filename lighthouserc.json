{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/services/soil-testing",
        "http://127.0.0.1:3000/favorite-plants",
        "http://127.0.0.1:3000/projects-blog",
        "http://127.0.0.1:3000/projects-blog/shade-border-reborn",
        "http://127.0.0.1:3000/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.01
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "font-size": "error",
        "color-contrast": "error",
        "heading-order": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "document-title": "error",
        "image-alt": "error",
        "label": "error",
        "link-name": "error",
        "is-crawlable": "error",
        "uses-responsive-images": "off",
        "unused-javascript": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
