# ── Contentful ────────────────────────────────────────────────────────────────
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API token — published content.
CONTENTFUL_DELIVERY_TOKEN=
# Content Preview API token — draft-mode route only.
CONTENTFUL_PREVIEW_TOKEN=
# Shared secret the Contentful webhook sends as `x-revalidate-secret`.
CONTENTFUL_REVALIDATE_SECRET=
# Secret guarding the draft-mode entry point.
CONTENTFUL_PREVIEW_SECRET=

# ── Email delivery (D5) ───────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sender on the Resend account.
RESEND_FROM_EMAIL=

# ── Spam protection (D7) ──────────────────────────────────────────────────────
# Both unset in dev/CI: the widget is not rendered and verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
